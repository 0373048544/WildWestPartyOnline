static func text(source: String) -> String:
	return str(TEXT.get(source, source))

static func message(source: String) -> String:
	# Wire errors stay English; only their presentation is localized.
	for prefix in ["Cannot host on that port: ", "Connection failed: "]:
		if source.begins_with(prefix) and not TEXT.has(source):
			# Engine error strings are technical details, not player-facing prose.
			return "Không thể tạo phòng trên cổng này. Hãy kiểm tra cổng hoặc thử cổng khác." if prefix.begins_with("Cannot") else "Kết nối thất bại. Hãy kiểm tra địa chỉ IP và cổng."
	return text(source)

static func card_name(id: String) -> String:
	if id.is_empty():
		return text("No equipment")
	return str(CardData.data(id).get("name", id))
